<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playback_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/player_background"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/player_container"
        android:layout_width="match_parent"
        android:layout_height="220dp">

        <com.google.android.exoplayer2.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:controller_layout_id="@layout/exo_player_control_view"
            app:hide_on_touch="true"
            app:resize_mode="fit"
            app:show_buffering="when_playing"
            app:show_timeout="4000"
            app:use_controller="true" />

        <ProgressBar
            android:id="@+id/player_progress"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/seek_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_duration"
            android:padding="12dp"
            android:textColor="@color/phone_on_surface"
            android:textSize="18sp"
            android:visibility="gone" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/detail_section"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/phone_bg"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/player_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:textColor="@color/phone_on_surface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/player_channel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:textColor="@color/phone_on_surface_muted"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:id="@+id/player_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_like"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:text="@string/action_like"
                        android:textColor="@color/phone_on_surface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_share"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/action_share"
                        android:textColor="@color/phone_on_surface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_watch_later"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/action_watch_later"
                        android:textColor="@color/phone_on_surface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_download"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/action_download"
                        android:textColor="@color/phone_on_surface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_comments"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/comments"
                        android:textColor="@color/phone_on_surface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cast"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/action_cast"
                        android:textColor="@color/phone_on_surface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_quality"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/quality"
                        android:textColor="@color/phone_on_surface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_speed"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/speed"
                        android:textColor="@color/phone_on_surface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_subtitle"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/subtitles"
                        android:textColor="@color/phone_on_surface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_resize"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/video_fill"
                        android:textColor="@color/phone_on_surface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_fullscreen"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/fullscreen"
                        android:textColor="@color/phone_on_surface" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/player_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:textColor="@color/phone_on_surface_muted"
                android:textSize="13sp"
                android:maxLines="4" />

            <LinearLayout
                android:id="@+id/suggestions_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="@string/suggestions"
                    android:textColor="@color/phone_on_surface"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/suggestions_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
